{
    "name": "server",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "nodemon",
        "postinstall": "patch-package",
        "typeorm": "ts-node --transpile-only -r tsconfig-paths/register ./node_modules/.bin/typeorm -d ./dataSource.ts",
        "typeorm:create": "npm run typeorm migration:generate ./db/migrations/$npm_config_name",
        "typeorm:down": "npm run typeorm migration:revert",
        "typeorm:prod": "node ./node_modules/.bin/typeorm -d dist/data-source.js",
        "typeorm:prod:create": "npm run typeorm:prod migration:generate dist/db/migrations/$npm_config_name",
        "typeorm:prod:down": "npm run typeorm:prod migration:revert",
        "typeorm:prod:up": "npm run typeorm:prod migration:run",
        "typeorm:up": "npm run typeorm migration:run"
    },
    "dependencies": {
        "@babel/cli": "^7.24.7",
        "@babel/core": "^7.24.7",
        "@fastify/cors": "^9.0.1",
        "@fastify/swagger": "^8.14.0",
        "@fastify/swagger-ui": "^4.0.0",
        "@tanstack/react-query": "^5.45.1",
        "@trpc/react-query": "^11.0.0-rc.417",
        "@trpc/server": "^11.0.0-rc.417",
        "@types/bcrypt": "^5.0.2",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/uuid": "^10.0.0",
        "bcrypt-ts": "^5.0.2",
        "class-transformer": "^0.1.0-beta.10",
        "cors": "^2.8.5",
        "cross-var": "^1.1.0",
        "dotenv": "^16.4.5",
        "eslint": "^9.5.0",
        "fastify": "^4.28.0",
        "jsonwebtoken": "^9.0.2",
        "nodemon": "^3.1.4",
        "patch-package": "^8.0.0",
        "pluralize": "^8.0.0",
        "tsconfig-paths": "^4.2.0",
        "typeorm": "^0.3.20",
        "uuidv4": "^6.2.13",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@swc/core": "^1.6.5",
        "@swc/plugin-relay": "^2.0.8",
        "@types/node": "^20.14.8",
        "@types/pluralize": "^0.0.33",
        "babel-plugin-module-resolver": "^5.0.2",
        "mysql2": "^3.10.1",
        "reflect-metadata": "^0.2.2"
    }
}
