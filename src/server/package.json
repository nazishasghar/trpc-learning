{
    "name": "server",
    "version": "1.0.0",
    "private": true,
    "type": "commonjs",
    "scripts": {
        "typeorm": "typeorm-ts-node-commonjs -d dist/data-source.ts",
        "start": "nodemon",
        "typeorm:create": "npm run typeorm migration:generate db/migrations/$npm_config_name",
        "typeorm:down": "npm run typeorm migration:revert",
        "typeorm:up": "npm run typeorm migration:run",
        "cmd": "ts-node -r tsconfig-paths/register --transpile-only cmd.ts"
    }
}
