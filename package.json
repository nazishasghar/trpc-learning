        "stylelint-config-recommended": "^14.0.1",
        "stylelint-config-standard": "^36.0.1",
        "stylelint-order": "^6.0.4",
        "superjson": "^2.2.1",
        "trpc-transformer": "^3.2.2",
        "ts-node": "^10.9.2",
