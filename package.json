{
    "name": "trpc-demo",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "prepare": "husky",
        "postinstall": "patch-package",
        "dev:server": "cd src/server && npm run start",
        "dev:admin": "cd src/admin && npm run dev",
        "dev:client": "cd src/client && npm run dev",
        "dev": "npm-run-all --parallel dev:*",
        "build:admin": "cd src/admin && npm run build",
        "build:client": "cd src/client && npm run build",
        "build:server": "cd src/server && rimraf dist && npx swc ../server -d dist",
        "build": "npm-run-all --parallel build:*",
        "start:prod": "cross-env RUNNING_JS=true node src/server/dist/index",
        "build:": "npm run build:chakra && cross-env NODE_ENV=production vite build",
        "build:chakra": "chakra-cli tokens ./utils/chakra-theme.ts",
        "cmd:prod": "cross-env RUNNING_JS=true node src/server/dist/cmd.js",
        "typeorm:prod": "node node_modules/.bin/typeorm -d src/server/dist/data-source.js",
        "typeorm:prod:create": "npm run typeorm:prod migration:generate src/server/dist/db/migrations/$npm_config_name",
        "typeorm:prod:down": "npm run typeorm:prod migration:revert",
        "typeorm:prod:up": "npm run typeorm:prod migration:run",
        "ts-check:server": "cd src/server && npx tsc",
        "ts-check:client": "cd src/client && npx tsc",
        "ts-check:admin": "cd src/admin && npx tsc",
        "ts-check": "npm-run-all ts-check:* && rimraf dist && cd ../..",
        "lint": "npm-run-all lint:*",
        "lint:code": "eslint --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content --ext .ts,.js,.vue,.jsx,.tsx --max-warnings 0 .",
        "fix": "npm-run-all fix:*",
        "fix:code": "npm run lint:code -- --fix",
        "fix:prettier": "prettier --config .prettierrc",
        "test": "jest",
        "test:ci": "jest --ci --coverage --forceExit",
        "test:cov": "jest --coverage",
        "test:cov:result": "opener ./.pages/cov/index.html",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "test:watch": "jest --watch",
        "client:test": "vitest --watch --reporter=default --reporter=junit",
        "client:test:ui": "vitest --watch --reporter=default --reporter=junit --ui",
        "client:test:cov": "vitest run --reporter=default --reporter=junit --coverage",
        "client:test:ci": "vitest run --reporter=default --reporter=junit --coverage --passWithNoTests",
        "client:test:cov:result": "opener ./.pages/cov/index.html",
        "storybook": "storybook dev -p 6006"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
